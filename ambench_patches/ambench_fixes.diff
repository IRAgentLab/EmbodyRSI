+def _blend_ee(a_old, a_new, w):
+    """按权重 w 把旧块的第 i 步和新块的第 i 步融合（w=0 全旧，w=1 全新）。
+
+    位置和夹爪线性插值；四元数先对齐符号（q 与 -q 同一旋转）再插值归一化。
+    维度不是 8 时不做假设，直接返回新块的值。
+    """
+    if a_old.shape[-1] != 8 or a_new.shape[-1] != 8:
+        return a_new
+    out = a_new.clone()
+    out[..., :3] = (1.0 - w) * a_old[..., :3] + w * a_new[..., :3]
+    out[..., 7] = (1.0 - w) * a_old[..., 7] + w * a_new[..., 7]
