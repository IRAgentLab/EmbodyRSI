 """Scripted policy for frame assembly task."""
 
+import os
+import torch
 import isaaclab.utils.math as math_utils
 
 from .base import BasePolicy, Waypoint
@@ -127,3 +129,48 @@ class FrameAssemblyPolicy(BasePolicy):
         ]
 
         self._log_trajectory_summary()
+
+    # ---- 闭环补偿：框架在爪里会下滑/摆动，到墙前按实测偏移重算插入路点 ----
+    REPLAN_T = 2750          # approach_wall 的停顿点（见上面的路点表）
+    REPLAN_END = 3200        # 松爪为止每步刷新
+    FRAME_INSERT_X = -0.06   # 原路点隐含的目标：插入结束时框架中心在 peg_center.x − 0.06
+
+    def _replan_insert(self, obs, env_id: int) -> None:
+        obs_dict = obs["policy"][env_id]
+        ee_pos = obs_dict["ee_pos"].clone()
+        frame_pos = obs_dict["frame_pos"].clone()
+        peg_center = obs_dict["peg_center_pos"].clone()
+        off = frame_pos - ee_pos                       # 实测 frame − ee
+        identity_quat = self.identity_quat()
+        insert_pos = peg_center - off
+        insert_pos[0] += self.FRAME_INSERT_X
+        if self.step_count == self.REPLAN_T or not hasattr(self, "_hold_pos"):
+            self._hold_pos = ee_pos.clone()
+        hold_pos = self._hold_pos
+        retract_pos = insert_pos.clone()
+        retract_pos[0] = peg_center[0] - 0.60
+        keep = [wp for wp in self.waypoints if wp.t < self.REPLAN_T]
+        self.waypoints = keep + [
+            Waypoint(t=self.REPLAN_T, xyz=hold_pos, quat=identity_quat, gripper=-1.0),
+            Waypoint(t=3100, xyz=insert_pos, quat=identity_quat, gripper=-1.0),
+            Waypoint(t=3200, xyz=insert_pos, quat=identity_quat, gripper=1.0),
+            Waypoint(t=3400, xyz=retract_pos, quat=identity_quat, gripper=1.0),
+        ]
+        if self.step_count == self.REPLAN_T:
+          self._log_trajectory_summary(
+            f"replan@{self.REPLAN_T}: frame-ee offset x/y/z = {off[0].item():+.3f}/{off[1].item():+.3f}/{off[2].item():+.3f}"
+        )
+
+    def advance(self, obs, env_id) -> torch.Tensor:
+        if (
+            self.trajectory_generated
+            and self.REPLAN_T <= self.step_count <= self.REPLAN_END
+            and os.environ.get("AMBENCH_FRAME_REPLAN", "1") == "1"
+        ):
+            self._replan_insert(obs, env_id)
+        return super().advance(obs, env_id)
+
+    def reset(self):
+        super().reset()
+        if hasattr(self, "_hold_pos"):
+            del self._hold_pos
